# Front (Vite). Em produção (Vercel) aponte para a URL da API no Render.
# Em dev, deixe vazio: o proxy do Vite encaminha /api -> http://localhost:3333
VITE_API_URL=

# Gerador de Laudos — URL do bundle de impressão (apps/report-print) usado na
# prévia do PDF dentro do módulo. Dev: porta 5180. Prod: URL do medro-report-print.
VITE_REPORT_PRINT_URL=http://localhost:5180
